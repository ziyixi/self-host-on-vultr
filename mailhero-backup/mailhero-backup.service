[Unit]
Description=Mail Hero encrypted snapshot collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=xiziyi
Group=xiziyi
UMask=0077
EnvironmentFile=/home/xiziyi/.config/mail-hero-backup/credentials.env
ExecStart=/usr/local/libexec/mailhero-backup-run
TimeoutStartSec=2000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/xiziyi/mail-hero-backup
