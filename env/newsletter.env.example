# Documentation only. Copy to a NEW private env/newsletter.env, mode 600.
# Compose reads raw env values: do not shell-quote them or use $ interpolation.
NEWSLETTER_MODE=live
NEWSLETTER_EDITOR=codex
NEWSLETTER_MODEL=gpt-5.6-sol
NEWSLETTER_TIME_ZONE=America/Los_Angeles
NEWSLETTER_JOB_TIMEOUT_SECONDS=900
NEWSLETTER_COLLECTION_TIMEOUT_SECONDS=600
# Compose fixes these non-secret deployment settings for the pinned DAG release.
# The external trigger allows 7200 seconds, including protected delivery stages.
NEWSLETTER_WORKFLOW=dag
NEWSLETTER_WORKFLOW_TIMEOUT_SECONDS=5400
# Generate three distinct random values of at least 24 characters.
NEWSLETTER_INGEST_TOKEN=
NEWSLETTER_EDITOR_TOKEN=
NEWSLETTER_SEND_TOKEN=
NEWSLETTER_NOTION=notion
NOTION_TOKEN=
# Share both independent databases with the same connection (Read/Insert/Update).
# Use data source IDs, not page/database IDs; set both or neither.
NOTION_MATERIALS_DATA_SOURCE_ID=
NOTION_EDITIONS_DATA_SOURCE_ID=
# Explicit consent is required to archive Todofy events. Keep that database private.
NEWSLETTER_NOTION_ARCHIVE_PRIVATE=false
# Run the documented notion_cli setup before the first dual-database startup.
# Legacy single-database mode only, when both new IDs are unset:
# NOTION_DATA_SOURCE_ID=
NEWSLETTER_TODOFY=todofy
NEWSLETTER_TODOFY_MODE=recommendation
NEWSLETTER_TODOFY_TOP=5
TODO_API_BASE=https://daily.ziyixi.science
TODO_API_USER=
TODO_API_PASSWORD=
# Bind a NEW live data directory to this delivery target from the first start.
# Do not reuse a mock/fake-mail database or switch its target in place.
NEWSLETTER_MAIL=resend
NEWSLETTER_ALLOW_SEND=true
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=The Daily Briefing <onboarding@resend.dev>
RECIPIENT_EMAIL=you@example.com
